# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# 기본 이미지 모델 (gpt-image-2, gpt-image-1.5, gpt-image-1, gpt-image-1-mini 등)
OPENAI_IMAGE_MODEL=gpt-image-2

PORT=3000

# Rhino MCP 서버 실행 명령 (https://github.com/jingcheng-chen/rhinomcp)
# Rhino 에서 플러그인 설치 후 'mcpstart' 명령으로 소켓(기본 1999 포트)을 열어두세요.
RHINO_MCP_COMMAND=uvx rhinomcp@latest
# Rhino 연동을 끄려면 1
RHINO_MCP_DISABLED=0
